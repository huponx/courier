HOST=0.0.0.0
# local ports differ from identity (gRPC 9090) and gatekeeper (8081) so everything runs on one machine
PORT=9091
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info
LOG_ENCODING=console
SERVICE_NAME=courier
# local: services are not authenticated on gRPC. Any other value requires ServiceAccount tokens.
ENV=local
DEFAULT_LOCALE=en
# Outside local: audience of the callers' ServiceAccount tokens and the accepted callers (comma separated).
COURIER_AUTH_AUDIENCE=courier
COURIER_AUTH_ALLOWED=
# courierctl against a cluster: a projected or `kubectl create token --audience courier` token file.
COURIER_TOKEN_FILE=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# The courier_* tables come from db-migration (V41); scripts/local.sh uses the shared local database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SSLMODE=disable

HEALTH_ADDR=:8082
QUEUE_MAX_RETRY=5
QUEUE_CLAIM_MIN_IDLE=30s
QUEUE_RELAY_INTERVAL=5s
QUEUE_RELAY_STALE=10m
RETENTION_DAYS=90

TELEGRAM_BOT_TOKEN=
# The bot of the portal's "Link Telegram" button (courier) and whether the worker listens to it for /start <code>.
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Local: write the mails as HTML/text files here instead of sending them (SMTP_* is then unused).
MAIL_DIR=
# Name and logo of the HTML emails (a caller can override both with `brand` and `logo_url` in the template data).
MAIL_BRAND=
MAIL_LOGO_URL=

GRPC_TARGET=localhost:9091
GRPC_TIMEOUT=5s
GRPC_INSECURE=true

# Resolve user_ids of Notify through identity, with the client credentials of the client `courier` (scripts/local.sh
# makes `courier-dev` and its secret in .local/courier.secret).
IDENTITY_TARGET=localhost:9090
IDENTITY_INSECURE=true
IDENTITY_TOKEN_URL=http://localhost:8080/oauth2/token
IDENTITY_CLIENT_ID=courier-dev
IDENTITY_CLIENT_SECRET=
USER_CACHE_TTL=60s

# User tokens of the inbox (the bell): iss and keys of identity; the audience is COURIER_AUTH_AUDIENCE.
COURIER_ISSUER=http://localhost:8080
COURIER_JWKS_URL=http://localhost:8080/.well-known/jwks.json
INBOX_RETENTION_DAYS=365

# Prometheus metrics (courier and worker; two processes on one machine need two ports, scripts/local.sh sets them).
METRICS_ADDR=:9100
# Webhooks may point to http and private addresses (a local run only).
WEBHOOK_ALLOW_PRIVATE=true

# Web Push (`go run ./cmd/courierctl vapid` makes the pair; the worker needs all three, courier the public key).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
