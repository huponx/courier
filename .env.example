HOST=0.0.0.0
PORT=9090
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info
LOG_ENCODING=console
SERVICE_NAME=courier
ENV=dev
DEFAULT_LOCALE=en
# Receiver S2S secret (K8s: secretKeyRef). Leave empty for local. Do not commit a real value.
COURIER_S2S_TOKEN=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

HEALTH_ADDR=:8081
QUEUE_MAX_RETRY=5
QUEUE_CLAIM_MIN_IDLE=30s

TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GRPC_TARGET=localhost:9090
GRPC_TIMEOUT=5s
GRPC_INSECURE=true
