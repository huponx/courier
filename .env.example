HOST=0.0.0.0
PORT=9090
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info
LOG_ENCODING=console
SERVICE_NAME=courier
# local: gRPC auth is optional (open unless COURIER_S2S_TOKEN is set). Any other value requires ServiceAccount tokens.
ENV=local
DEFAULT_LOCALE=en
# Optional static Bearer token, read only when ENV=local (courier and courierctl). Do not commit a real value.
COURIER_S2S_TOKEN=
# Outside local: audience of the callers' ServiceAccount tokens and the accepted callers (comma separated).
COURIER_AUTH_AUDIENCE=courier
COURIER_AUTH_ALLOWED=
# courierctl against a cluster: a projected or `kubectl create token --audience courier` token file.
COURIER_TOKEN_FILE=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

HEALTH_ADDR=:8081
QUEUE_MAX_RETRY=5
QUEUE_CLAIM_MIN_IDLE=30s

TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GRPC_TARGET=localhost:9090
GRPC_TIMEOUT=5s
GRPC_INSECURE=true
