<h1>{{.count}} registrations awaiting approval</h1>
<p>Hello <strong>{{.name}}</strong>,</p>
<p>{{.count}} people registered and wait for your decision.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:4px 0 24px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">{{range lines .items}}<tr><td width="20" valign="top" style="padding:8px 0 8px 14px;width:20px;font-size:13px;line-height:20px;color:#9ca3af;border-bottom:1px solid #e5e7eb;">&bull;</td><td valign="top" style="padding:8px 14px 8px 8px;font-size:13px;line-height:20px;color:#111827;border-bottom:1px solid #e5e7eb;">{{.}}</td></tr>{{end}}</table>
{{if .link}}<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;"><tr><td bgcolor="#4f46e5" style="border-radius:8px;"><a href="{{.link}}" style="display:inline-block;padding:13px 28px;font-size:15px;font-weight:600;line-height:20px;color:#ffffff;text-decoration:none;border-radius:8px;">Review the first request</a></td></tr></table>
<p class="muted">If the button does not work, copy this link into your browser:<br><a href="{{.link}}" style="word-break:break-all;">{{.link}}</a></p>
{{end}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 0;"><tr><td style="background:#f9fafb;border-left:3px solid #d1d5db;border-radius:4px;padding:12px 16px;font-size:13px;line-height:20px;color:#4b5563;">You can approve or reject each request in the admin app. No link is sent to an applicant until you approve.</td></tr></table>
