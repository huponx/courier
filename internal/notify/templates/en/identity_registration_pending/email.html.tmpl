<h1>New registration awaiting approval</h1>
<p>Hello <strong>{{.name}}</strong>,</p>
<p>Someone registered and waits for your decision.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:4px 0 24px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;"><tr><td style="padding:10px 16px;font-size:13px;color:#6b7280;width:90px;border-bottom:1px solid #e5e7eb;">Name</td><td style="padding:10px 16px;font-size:14px;font-weight:600;color:#111827;border-bottom:1px solid #e5e7eb;">{{.applicant_name}}</td></tr><tr><td style="padding:10px 16px;font-size:13px;color:#6b7280;width:90px;border-bottom:1px solid #e5e7eb;">E-mail</td><td style="padding:10px 16px;font-size:14px;font-weight:600;color:#111827;border-bottom:1px solid #e5e7eb;">{{.applicant_email}}</td></tr></table>
{{if .link}}<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;"><tr><td bgcolor="#4f46e5" style="border-radius:8px;"><a href="{{.link}}" style="display:inline-block;padding:13px 28px;font-size:15px;font-weight:600;line-height:20px;color:#ffffff;text-decoration:none;border-radius:8px;">Review request</a></td></tr></table>
<p class="muted">If the button does not work, copy this link into your browser:<br><a href="{{.link}}" style="word-break:break-all;">{{.link}}</a></p>
{{end}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 0;"><tr><td style="background:#f9fafb;border-left:3px solid #d1d5db;border-radius:4px;padding:12px 16px;font-size:13px;line-height:20px;color:#4b5563;">You can approve or reject the request there. No link is sent to the applicant until you approve.</td></tr></table>
